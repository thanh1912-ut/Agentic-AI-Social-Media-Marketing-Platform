# Frontend — copy sang .env.local rồi chỉnh.
# Next.js chỉ đọc .env.local trong apps/web khi chạy `npm run dev` từ apps/web.
# Khi chạy từ gốc repo, biến lấy từ môi trường hoặc .env ở gốc.

# Gốc API, KHÔNG gồm /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 1 = dùng dữ liệu demo (MSW), không gọi backend. Đặt 0 khi M2 đã có API.
NEXT_PUBLIC_USE_MOCKS=1

# Nhãn môi trường hiện trên thanh trên cùng. Để trống nếu không cần.
NEXT_PUBLIC_ENVIRONMENT_LABEL=Bản demo
