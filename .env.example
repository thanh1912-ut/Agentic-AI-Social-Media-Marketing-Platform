# ===== App =====
APP_NAME=agentic-marketing
APP_ENV=development
LOG_LEVEL=info
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# ===== Frontend (apps/web) =====
# ⚠️ Tên phải ĐÚNG CHÍNH XÁC. Nếu sai, frontend vẫn chạy nhưng âm thầm gọi nhầm
# địa chỉ API (rơi về mặc định http://127.0.0.1:8000) mà không báo lỗi.
# Gốc API, KHÔNG gồm /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 1 = chạy bằng dữ liệu demo, không gọi backend.
NEXT_PUBLIC_USE_MOCKS=0
# Nhãn hiện trên thanh trên cùng, ví dụ: Bản pilot
NEXT_PUBLIC_ENVIRONMENT_LABEL=

# ===== Database =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_marketing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_marketing

# ===== Redis / Queue =====
REDIS_URL=redis://localhost:6379/0

# ===== Object storage =====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agentic-marketing
STORAGE_BACKEND=local
STORAGE_ROOT=.data/uploads

# ===== Auth =====
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_REQUEST=10
PARSER_VERSION=m2-parser-v1
AUTO_CREATE_SCHEMA=0
INLINE_JOBS=0

# ===== LLM providers =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ===== Agentic AI =====
LANGGRAPH_CHECKPOINT_URL=
AGENT_MAX_RETRIES=3

# ===== Social integrations =====
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
