# ===== App =====
APP_NAME=agentic-marketing
APP_ENV=development
LOG_LEVEL=info
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated proxy IPs/CIDRs. Never use '*' in production.
FORWARDED_ALLOW_IPS=127.0.0.1

# ===== Frontend (apps/web) =====
# ⚠️ Tên phải ĐÚNG CHÍNH XÁC. Nếu sai, frontend vẫn chạy nhưng âm thầm gọi nhầm
# địa chỉ API (rơi về mặc định http://127.0.0.1:8000) mà không báo lỗi.
# Gốc API, KHÔNG gồm /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 1 = chạy bằng dữ liệu demo, không gọi backend.
NEXT_PUBLIC_USE_MOCKS=0
# Nhãn hiện trên thanh trên cùng, ví dụ: Bản pilot
NEXT_PUBLIC_ENVIRONMENT_LABEL=

# ===== Database =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_marketing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_marketing

# ===== Redis / Queue =====
REDIS_URL=redis://localhost:6379/0
REDIS_MAXMEMORY=256mb
# Optional response cache. Keep this on a separate Redis instance from Celery.
REDIS_CACHE_URL=redis://localhost:6380/0
REDIS_CACHE_MAXMEMORY=64mb
REDIS_CACHE_PORT=6380
# Local development may disable app rate limits; set to 1 in production (required).
RATE_LIMITS_ENABLED=0

# ===== Object storage =====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agentic-marketing
STORAGE_BACKEND=local
STORAGE_ROOT=.data/uploads

# ===== Auth =====
# Local development only. Production refuses this built-in value.
JWT_SECRET=change-me-in-development-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Email (optional; invite links have a manual fallback) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD= # Secret: configure only in the server runtime environment
SMTP_STARTTLS=1
SMTP_SSL=0
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BODY_BYTES=268435456
MAX_IMAGE_BYTES=12582912
MAX_IMAGE_PIXELS=40000000
MAX_FILES_PER_REQUEST=10
PARSER_VERSION=m2-parser-v2
AUTO_CREATE_SCHEMA=0
INLINE_JOBS=0
# Maximum same-host pages read from each website per crawl (1-25).
MARKET_CRAWL_MAX_PAGES=25

# ===== LLM providers =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY= # Secret: set only in server runtime environment
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=8192
LLM_MAX_INPUT_CHARS=24000
AI_REQUEST_TIMEOUT_SECONDS=120

# Embeddings are independent of DeepSeek. The local FastEmbed model processes
# workspace text in this deployment; only model weights are downloaded on first
# use. `none` is an explicit lexical-only fallback. External providers require
# separate data-flow approval.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_DATA_FLOW_APPROVED=0
EMBEDDING_API_KEY= # Separate server-only secret; required only for openai embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=.data/embedding-models
EMBEDDING_THREADS=2
EMBEDDING_LOCAL_FILES_ONLY=0
RETRIEVAL_MODE=semantic_vector
CHUNKER_VERSION=vi-token-window-v3-300
MINIMUM_RELEVANCE_SCORE=0.12
MINIMUM_SEMANTIC_SCORE=0.82
MINIMUM_SEMANTIC_MARGIN=0.04
MINIMUM_HYBRID_LEXICAL_SCORE=0.45

# ===== Agentic AI =====
LANGGRAPH_CHECKPOINT_URL=
AGENT_MAX_RETRIES=3

# ===== Social integrations =====
# New Page connections are entered in Fanpage & market research after login.
# The backend verifies Page ID + token and encrypts tokens with the key below.
# Never use NEXT_PUBLIC_ for a Page access token or commit a populated .env.
# The three META_* connection values below remain only for legacy pilot fallback;
# META_WORKSPACE_ID must be the exact workspace allowed to use that Page.
META_WORKSPACE_ID=
META_PAGE_ID=
# Secret: set only in an ignored local .env or deployment secret store.
META_PAGE_ACCESS_TOKEN=
# Optional secret: app/user access token for competitor Pages. Meta must approve
# Page Public Content Access for this app before automatic competitor collection works.
META_PUBLIC_CONTENT_ACCESS_TOKEN=
# Default for the pilot; confirm that this version works with your Meta app/Page.
META_GRAPH_VERSION=v26.0
# Required to save user-entered Page tokens. Generate with the Python cryptography Fernet helper.
META_TOKEN_ENCRYPTION_KEY=
# Keep the previous key here during rotation; remove it after existing tokens are re-saved.
META_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Reserved for a future OAuth integration; manual Page token setup does not use these.
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
